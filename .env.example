# Flask server configuration
WIZE_ENV=development
WIZE_SECRET_KEY=

# SMTP account used by the Flask backend for verification and security email.
# Copy this file to .backend.env. Keep real credentials there and off Expo.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
AUTH_EMAIL_TIMEZONE=UTC

# Optional provider key used by live hotel search.
STAYING_API_KEY=
